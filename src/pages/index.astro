---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PDX Derby Dudes">
  <h1>PDX Derby Dudes</h1>
  <h2>Build. Race. Fun.</h2>

  <section>
    <h3>Who We Are</h3>
    <p>Youth-friendly derby racing experiences for groups and families.</p>
  </section>

  <section>
    <h3>What We Do</h3>
    <ul>
      <li>Build cars</li>
      <li>Race them</li>
      <li>Learn together</li>
    </ul>
  </section>

  <section>
    <h3>When It Happens</h3>
    <iframe
      src="PASTE_GOOGLE_CALENDAR_EMBED_URL"
      width="100%"
      height="600"
      loading="lazy">
    </iframe>
  </section>

  <section>
    <h3>Sign Up</h3>
    <iframe
      src="PASTE_GOOGLE_FORM_EMBED_URL"
      width="100%"
      height="800"
      loading="lazy">
    </iframe>
  </section>

  <section>
    <h3>Stay Connected</h3>
    <form name="email-signup" method="POST" data-netlify="true">
      <input type="hidden" name="form-name" value="email-signup" />
      <input name="email" type="email" placeholder="Email address" required />
      <button type="submit">Submit</button>
    </form>
  </section>
</BaseLayout>
