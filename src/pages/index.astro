---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PDX Derby Dudes">
  <h1>PDX Derby Dudes</h1>
  <h2>Build. Race. Fun.</h2>

  <section>
    <h3>Who We Are</h3>
    <p>Youth-friendly derby racing experiences for groups and families.</p>
  </section>

  <section>
    <h3>What We Do</h3>
    <ul>
      <li>Build cars</li>
      <li>Race them</li>
      <li>Learn together</li>
    </ul>
  </section>

  <section>
    <h3>When It Happens</h3>
<iframe
  src="https://calendar.google.com/calendar/embed?src=so0a27mk0qs8k46nn7r3d9ig1g%40group.calendar.google.com&ctz=America%2FLos_Angeles"
  style="border:0"
  width="100%"
  height="600"
  frameborder="0"
  scrolling="no">
</iframe>

  </section>

  <section>
    <h3>Sign Up</h3>
<iframe
  src="https://docs.google.com/forms/d/e/1FAIpQLSdhmmCCXBvopgVsvFy2haHlAcGrpM6tDA1kIyGBmPSq5Szr5g/viewform?embedded=true"
  width="100%"
  height="3080"
  frameborder="0"
  marginheight="0"
  marginwidth="0">
  Loading…
</iframe>

  </section>

  <section>
    <h3>Stay Connected</h3>
    <form name="email-signup" method="POST" data-netlify="true">
      <input type="hidden" name="form-name" value="email-signup" />
      <input name="email" type="email" placeholder="Email address" required />
      <button type="submit">Submit</button>
    </form>
  </section>
</BaseLayout>
